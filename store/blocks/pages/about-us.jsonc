{
  "store.custom#about-us": {
    "children": [
      "flex-layout.row#linha-quem-somos",
      "flex-layout.row#linha-selos-quem-somos",
      "flex-layout.row#linha-nosso-proposito",
      "responsive-layout.desktop#colunas-biosseguranca",
      "responsive-layout.mobile#colunas-biosseguranca",
      "flex-layout.row#titulo-pq-ecolher"
    ]
  },
  // LINHA QUEM SOMOS
  "flex-layout.row#linha-quem-somos": {
    "props": {
      "blockClass": "linha-quem-somos",
      "colSizing": "auto",
      "fullWidth": false
    },
    "children": [
      "rich-text#titulo-quem-somos",
      "rich-text#texto-quem-somos"
    ],
    "title": "Banner quem somos"
  },
  // TITULO QUEM SOMOS
  "rich-text#titulo-quem-somos": {
    "props": {
      "text": "Quem Somos",
      "blockClass": "titulo-quem-somos"
    },
    "title": "Titulo quem somos"
  },
  // TEXTO QUEM SOMOS
  "rich-text#texto-quem-somos": {
    "props": {
      "text": "Com sede em Pinhais (PR) e atuação em todo o país, oferecemos uma experiência de compra direta de fábrica, unindo qualidade, segurança e confiança para clínicas, consultórios, hospitais e laboratórios. Ao longo de sua trajetória, a Stermax se consolidou como referência no setor, investindo continuamente em inovação e excelência para transformar a rotina de esterilização.",
      "blockClass": "texto-quem-somos",
      "textAlignment": "CENTER"
    },
    "title": "Texto quem somos"
  },
  // SELOS
  "flex-layout.row#linha-selos-quem-somos": {
    "props": {
      "blockClass": "linha-selos-quem-somos",
      "colSizing": "auto"
    },
    "children": [
      "responsive-layout.desktop#banner-quem-somos",
      "responsive-layout.mobile#banner-quem-somos"
    ]
  },
  "responsive-layout.desktop#banner-quem-somos": {
    "children": [
      "flex-layout.col#coluna-selos-desde-quem-somos",
      "flex-layout.col#coluna-selos-300mil-quem-somos",
      "flex-layout.col#coluna-selos-lider-quem-somos",
      "flex-layout.col#coluna-selos-nacional-quem-somos"
    ]
  },
  // colunas desktop dos selos
  "flex-layout.col#coluna-selos-desde-quem-somos": {
    "props": {
      "blockClass": "coluna-selos"
    },
    "children": [
      "image#icone-desde",
      "image#img-texto-desde"
    ]
  },
  "flex-layout.col#coluna-selos-300mil-quem-somos": {
    "props": {
      "blockClass": "coluna-selos"
    },
    "children": [
      "image#icone-300mil",
      "image#img-texto-300mil"
    ]
  },
  "flex-layout.col#coluna-selos-lider-quem-somos": {
    "props": {
      "blockClass": "coluna-selos"
    },
    "children": [
      "image#icone-lider",
      "image#img-texto-lider"
    ]
  },
  "flex-layout.col#coluna-selos-nacional-quem-somos": {
    "props": {
      "blockClass": "coluna-selos"
    },
    "children": [
      "image#icone-nacional",
      "image#img-texto-nacional"
    ]
  },
  "image#icone-desde": {
    "props": {
      "src": "assets/quem-somos/desde-91.webp",
      "alt": "Img selos",
      "blockClass": "icone-selos"
    }
  },
  "image#img-texto-desde": {
    "props": {
      "src": "assets/quem-somos/desde-91-texto.webp",
      "alt": "Img selos",
      "blockClass": [
        "icone-selos",
        "icone-selos-menor"
      ]
    }
  },
  "image#icone-300mil": {
    "props": {
      "src": "assets/quem-somos/vendidas.webp",
      "alt": "Img selos",
      "blockClass": [
        "icone-selos"
      ]
    }
  },
  "image#img-texto-300mil": {
    "props": {
      "src": "assets/quem-somos/300mil-texto.webp",
      "alt": "Img selos",
      "blockClass": [
        "icone-selos"
      ]
    }
  },
  "image#icone-lider": {
    "props": {
      "src": "assets/quem-somos/lider.webp",
      "alt": "Img selos",
      "blockClass": [
        "icone-selos",
        "icone-selos-menor"
      ]
    }
  },
  "image#img-texto-lider": {
    "props": {
      "src": "assets/quem-somos/lider-texto.webp",
      "alt": "Img selos",
      "blockClass": "icone-selos"
    }
  },
  "image#icone-nacional": {
    "props": {
      "src": "assets/quem-somos/fab-nacional.webp",
      "alt": "Img selos",
      "blockClass": "icone-selos"
    }
  },
  "image#img-texto-nacional": {
    "props": {
      "src": "assets/quem-somos/fab-nacional-texto.webp",
      "alt": "Img selos",
      "blockClass": "icone-selos"
    }
  },
  "responsive-layout.mobile#banner-quem-somos": {
    "children": [
      "flex-layout.row#linha1-selos-mobile",
      "flex-layout.row#linha2-selos-mobile"
    ]
  },
  "flex-layout.row#linha1-selos-mobile": {
    "props": {
      "blockClass": "linha-selos-mobile",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.col#coluna-selos-desde-quem-somos",
      "flex-layout.col#coluna-selos-lider-quem-somos"
    ]
  },
  "flex-layout.row#linha2-selos-mobile": {
    "props": {
      "blockClass": "linha-selos-mobile",
      "colSizing": "auto"
    },
    "children": [
      "flex-layout.col#coluna-selos-300mil-quem-somos",
      "flex-layout.col#coluna-selos-nacional-quem-somos"
    ]
  },
  // LINHA NOSSO PROPOSITO
  "flex-layout.row#linha-nosso-proposito": {
    "props": {
      "blockClass": "linha-nosso-proposito",
      "colSizing": "auto"
    },
    "children": [
      "rich-text#titulo-nosso-proposito",
      "rich-text#texto-nosso-proposito"
    ]
  },
  "rich-text#titulo-nosso-proposito": {
    "props": {
      "blockClass": "titulo-nosso-proposito",
      "text": "Nosso propósito "
    }
  },
  "rich-text#texto-nosso-proposito": {
    "props": {
      "blockClass": "texto-nosso-proposito",
      "text": "Nossa missão é facilitar o acesso às soluções da Stermax com máxima conveniência e credibilidade. Aqui, você encontra todas as linhas de autoclaves horizontais , com suporte técnico decicado, manual de operação, compra segura e garantia de fábrica. A Stermax Health é a loja oficial da Stermax – marca líder em equipamentos de esterilização há mais de 30 anos no mercado. Nascemos para atender com excelência profissionais da saúde que exigem o mais alto padrão em biossegurança, oferecendo autoclaves horizontais e outros equipamentos certificados, fabricados no Brasil com qualidade internacional de fabricação. "
    }
  },
  // layout DESKTOP
  // LINHA COMPROMISSO biosseguranca
  "responsive-layout.desktop#colunas-biosseguranca": {
    "children": [
      "flex-layout.row#compromisso-biosseguranca"
    ]
  },
  "flex-layout.row#compromisso-biosseguranca": {
    "props": {
      "blockClass": "linha-compromisso-bioss"
    },
    "children": [
      "flex-layout.col#coluna-textos-biosseguranca",
      "flex-layout.col#coluna-imagem-biosseguranca"
    ]
  },
  // COLUNA ESQUERDA TEXTOS
  "flex-layout.col#coluna-textos-biosseguranca": {
    "props": {
      "blockClass": "biosseguranca-colunas-textos",
      "preventVerticalStretch": true,
      "width": "60%"
    },
    "children": [
      "rich-text#titulo-biosseguranca",
      "rich-text#texto-biosseguranca"
    ]
  },
  "rich-text#titulo-biosseguranca": {
    "props": {
      "blockClass": "titulo-biosseguranca",
      "text": "Nosso compromisso\n com a **Biossegurança**"
    }
  },
  "rich-text#texto-biosseguranca": {
    "props": {
      "blockClass": "texto-biosseguranca",
      "text": "A Stermax nasceu de profissionais que entendem a complexidade e a importância da biossegurança na rotina da saúde. Cada equipamento é desenvolvido para proporcionar esterilização confiável, durabilidade e eficiência, protegendo profissionais e pacientes."
    }
  },
  "flex-layout.col#coluna-imagem-biosseguranca": {
    "props": {
      "blockClass": "coluna-imagem-bioss",
      "width": "40%"
    },
    "children": [
      "image#img-biosseguranca"
    ]
  },
  "image#img-biosseguranca": {
    "props": {
      "blockClass": "image-biosseguranca",
      "alt": "Mulher biosseguranca",
      "src": "assets/quem-somos/desktop/bioseguranca-desktop.webp"
    }
  },
  // LAYOUT MOBILE
  "responsive-layout.mobile#colunas-biosseguranca": {
    "children": [
      "flex-layout.row#compromisso-biosseguranca-mobile"
    ]
  },
  "flex-layout.row#compromisso-biosseguranca-mobile": {
    "props": {
      "blockClass": "linha-compromisso-biosseguranca-mobile"
    },
    "children": [
      "rich-text#titulo-biosseguranca-mobile",
      "rich-text#texto-biosseguranca",
      "image#img-biosseguranca-mobile"
    ]
  },
  "image#img-biosseguranca-mobile": {
    "props": {
      "src": "assets/quem-somos/mobile/bioseguranca-mobile.webp",
      "alt": "Mulher biosseguranca",
      "blockClass": "image-biosseguranca-mobile"
    }
  },
    "rich-text#titulo-biosseguranca-mobile": {
    "props": {
      "blockClass": "titulo-biosseguranca",
      "text": "Nosso compromisso com a **Biossegurança**"
    }
  },
  // linha pq escolher
  "flex-layout.row#titulo-pq-ecolher":{
    "props": {
      "blockClass": "linha-pq-escolher",
      "colSizing": "auto"
    },
    "children": [
      "rich-text#titulo-pq-escolher",
      "responsive-layout.desktop#image-logo-stx",
      "responsive-layout.mobile#image-logo-stx"

    ]
  },
  "rich-text#titulo-pq-escolher":{
    "props": {
      "blockClass": "titulo-pq-escolher",
      "text": "Por que escolher a"
    }
  },
  "responsive-layout.desktop#image-logo-stx":{
    "children": [
        "image#logo-stx-quem-somos"
    ]
  },
  "responsive-layout.mobile#image-logo-stx":{
    "children": [
        "image#logo-stx-quem-somos-mobile"
    ]
  },
  "image#logo-stx-quem-somos":{
    "props": {
      "blockClass": "image-stx-logo-quem-somos",
      "src": "assets/quem-somos/desktop/stermax-health-desktop-quem-somos.webp"
    }
  },
  "image#logo-stx-quem-somos-mobile":{
    "props": {
      "blockClass": "image-stx-logo-quem-somos",
      "src": "assets/quem-somos/mobile/stermax-health-mobile-quem-somos.webp"
    }
  }
}
